{
  "name": "dsh-opening-splash",
  "version": "1.0.2",
  "description": "DeepSeek Harness opening splash: plays the DSH software-opening animation full screen when the Web UI boots, then fades into the app (skippable, speed and frequency configurable)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LIYue-hope/dsh-opening-splash.git"
  },
  "homepage": "https://github.com/LIYue-hope/dsh-opening-splash#readme",
  "bugs": {
    "url": "https://github.com/LIYue-hope/dsh-opening-splash/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "splash",
    "opening",
    "animation"
  ],
  "type": "module",
  "main": "lib/index.js",
  "scripts": {
    "test": "node tests/host.mjs && node tests/browser.mjs && node tests/account.mjs"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "assets",
    "cordis.patch.yml",
    "README.md",
    "PROVENANCE.md"
  ],
  "dsh": {
    "client": {
      "platform": "web",
      "inject": ["@deepseek-ai/dsh-api-remotes", "@deepseek-ai/dsh-client-locale"]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
